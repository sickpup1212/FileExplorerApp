# Copy to .env and adjust. Read by app.py at startup.

# PIN required to open the app. CHANGE THIS before exposing it anywhere.
FILE_EXPLORER_PIN=123456

# Password recovery code.
#
# If you forget your password, the login page's "Forgot your password?" option
# asks for this code, plus your username and a new password. Put it somewhere
# safe before you need it.
#
# Anyone with this code can take over any account on this server, so treat it
# like a master key. Falls back to FILE_EXPLORER_INVITE_CODE if not set.
# Leave both unset and the only way back in is `scripts/manage_users.py passwd`
# run on the server itself.
FILE_EXPLORER_RECOVERY_CODE=change-this-recovery-code

# Invite code for creating ADDITIONAL accounts.
#
# NOT needed for the first account: on a fresh install the first account is
# always allowed and becomes the administrator. This is only demanded once at
# least one account exists, to stop strangers registering on a server that is
# already set up. Uncomment to let more people register themselves.
# FILE_EXPLORER_INVITE_CODE=change-this-to-something-secret

# Signs session cookies. Leave unset and a key is generated into .secret_key.
# FLASK_SECRET_KEY=

# Where files are stored. Absolute, or relative to the project directory.
# Point at a media drive to browse existing media, e.g. E:\Media
STORAGE_ROOT=storage

# Thumbnail cache (regenerated automatically when a source file changes).
THUMBNAIL_CACHE_DIR=.thumbs

# Per-file upload ceiling. 0 = unlimited (best for multi-GB video).
MAX_UPLOAD_MB=0

# Listen address. 8080 rather than 5000: on Windows 5000 is often taken by
# another service, which fails with WinError 10013.
HOST=0.0.0.0
PORT=8080

# Set to 1 only when serving over HTTPS (e.g. behind a Cloudflare tunnel),
# otherwise the browser will refuse to send the session cookie.
COOKIE_SECURE=0

# Optional: shared token so scripts can call the API with an X-Auth-Token
# header instead of logging in. Grants full access - keep it secret.
# FILE_EXPLORER_TOKEN=

# Optional: stores accounts, folder PINs and share links. Your files always
# live on disk under STORAGE_ROOT. If set to postgres:// the psycopg2 driver
# must be installed, otherwise the app logs a warning and falls back to SQLite.
# DATABASE_URL=postgresql://user:password@host/dbname