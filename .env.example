# Flask Secret Key (change this to a random string)
FLASK_SECRET_KEY="a_very_secret_key"

# Database URL (for SQLite, you can use a file path)
# Example for SQLite: DATABASE_URL="sqlite:///instance/app.db"
# Example for PostgreSQL: DATABASE_URL="postgresql://user:password@localhost/mydatabase"
DATABASE_URL="sqlite:///instance/app.db"
